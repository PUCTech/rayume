{
  "info": {
    "name": "Rayume API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('ok is true', () => pm.expect(pm.response.json().ok).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"username\": \"{{username}}\",\n  \"name\": \"{{name}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// fresh account each run, so the collection can be rerun against the dev database",
                  "const run = Date.now().toString(36);",
                  "pm.environment.set('email', `postman-${run}@example.com`);",
                  "pm.environment.set('username', `postman_${run}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const cookie = (pm.response.headers.get('Set-Cookie') || '').match(/refresh_token=([^;]*)/);",
                  "pm.test('sets the refresh cookie', () => pm.expect(cookie && cookie[1]).to.be.ok);",
                  "pm.environment.set('accessToken', pm.response.json().access_token);",
                  "pm.environment.set('refreshToken', cookie[1]);",
                  "pm.test('returns the user', () => pm.expect(pm.response.json().user.username).to.eql(pm.environment.get('username')));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Register again (email taken)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"username\": \"{{username}}_2\",\n  \"name\": \"{{name}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('detail is email_taken', () => pm.expect(pm.response.json().detail).to.eql('email_taken'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Login with wrong password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('detail is invalid_credentials', () => pm.expect(pm.response.json().detail).to.eql('invalid_credentials'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const cookie = (pm.response.headers.get('Set-Cookie') || '').match(/refresh_token=([^;]*)/);",
                  "pm.test('sets the refresh cookie', () => pm.expect(cookie && cookie[1]).to.be.ok);",
                  "pm.environment.set('accessToken', pm.response.json().access_token);",
                  "pm.environment.set('refreshToken', cookie[1]);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [
              {
                "key": "Cookie",
                "value": "refresh_token={{refreshToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('oldRefreshToken', pm.environment.get('refreshToken'));",
                  "const cookie = (pm.response.headers.get('Set-Cookie') || '').match(/refresh_token=([^;]*)/);",
                  "pm.test('sets the refresh cookie', () => pm.expect(cookie && cookie[1]).to.be.ok);",
                  "pm.environment.set('accessToken', pm.response.json().access_token);",
                  "pm.environment.set('refreshToken', cookie[1]);",
                  "pm.test('rotates the token', () => pm.expect(cookie[1]).to.not.eql(pm.environment.get('oldRefreshToken')));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Refresh with the old token (reuse)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [
              {
                "key": "Cookie",
                "value": "refresh_token={{oldRefreshToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('detail is invalid_credentials', () => pm.expect(pm.response.json().detail).to.eql('invalid_credentials'));",
                  "const cookie = (pm.response.headers.get('Set-Cookie') || '').match(/refresh_token=([^;]*)/);",
                  "pm.test('clears the refresh cookie', () => pm.expect(cookie && cookie[1]).to.be.oneOf(['', '\"\"']));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Refresh after reuse (family revoked)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [
              {
                "key": "Cookie",
                "value": "refresh_token={{refreshToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "const cookie = (pm.response.headers.get('Set-Cookie') || '').match(/refresh_token=([^;]*)/);",
                  "pm.test('clears the refresh cookie', () => pm.expect(cookie && cookie[1]).to.be.oneOf(['', '\"\"']));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Login again",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const cookie = (pm.response.headers.get('Set-Cookie') || '').match(/refresh_token=([^;]*)/);",
                  "pm.test('sets the refresh cookie', () => pm.expect(cookie && cookie[1]).to.be.ok);",
                  "pm.environment.set('accessToken', pm.response.json().access_token);",
                  "pm.environment.set('refreshToken', cookie[1]);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [
              {
                "key": "Cookie",
                "value": "refresh_token={{refreshToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));",
                  "const cookie = (pm.response.headers.get('Set-Cookie') || '').match(/refresh_token=([^;]*)/);",
                  "pm.test('clears the refresh cookie', () => pm.expect(cookie && cookie[1]).to.be.oneOf(['', '\"\"']));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "Refresh after logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [
              {
                "key": "Cookie",
                "value": "refresh_token={{refreshToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "const cookie = (pm.response.headers.get('Set-Cookie') || '').match(/refresh_token=([^;]*)/);",
                  "pm.test('clears the refresh cookie', () => pm.expect(cookie && cookie[1]).to.be.oneOf(['', '\"\"']));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        }
      ]
    }
  ]
}
