# Copy to .env. Matches the db service in ../compose.yaml
DATABASE_URL=postgresql+psycopg://rayume:rayume@localhost:5432/rayume
# JSON list of frontend origins allowed by CORS
CORS_ORIGINS=["http://localhost:3000"]
# GitHub OAuth app: github.com > Settings > Developer settings > OAuth Apps (rayume-dev for local)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
