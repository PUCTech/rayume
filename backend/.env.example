# Copy to .env. Matches the db service in ../compose.yaml
DATABASE_URL=postgresql+psycopg://rayume:rayume@localhost:5432/rayume
# JSON list of frontend origins allowed by CORS
CORS_ORIGINS=["http://localhost:3000"]
# Key that signs access tokens. Required. For a real one:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Signing algorithm. Only this one is accepted when validating, never "none"
JWT_ALGORITHM=HS256
# `iss` claim: who issued the token. Change per environment so tokens don't cross
JWT_ISSUER=rayume
# `aud` claim: which API the token is for
JWT_AUDIENCE=rayume-api
# Access token lifetime in seconds (900 = 15 min), kept short because it can't be revoked
access_token_ttl_seconds=900
# Session lifetime in days, counted from login: after that the user must log in again
refresh_token_ttl_days=30
