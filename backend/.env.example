# Default: local database from docker compose. Shared Supabase: Connect > Session pooler, password URL-encoded (@ -> %40)
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://rayume:rayume@localhost:5432/rayume
CORS_ORIGINS=["http://localhost:3000"]
# Required, 32+ characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=rayume
JWT_AUDIENCE=rayume-api
access_token_ttl_seconds=900
refresh_token_ttl_days=30
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
